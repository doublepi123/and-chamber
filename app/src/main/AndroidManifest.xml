<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WebView voice input (the page requests the microphone through the app). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional phone-control overlay (default off). The draw-over grant is requested from system
         settings only; holding it is a permission, not proof that an overlay is visible. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Phone control (experimental): only launcher apps may be offered as targets. The picker asks
         for this exact intent; the app never requests QUERY_ALL_PACKAGES or lists all packages. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Shared storage (/sdcard/AndChamber). API 30+ uses MANAGE_EXTERNAL_STORAGE granted from Settings;
         API 26-29 use the runtime storage permissions, with legacy external storage requested. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".AndChamberApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndChamber">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification buttons and reply text. Not exported: only our own notifications reach it. -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!-- Multi-field form from a notification. Not exported: only our own immutable PendingIntent opens
             it. Its own task, so filling a form does not bring the main screen along; kept out of Recents. -->
        <activity
            android:name=".notify.NotificationFormActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.RuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-device OpenChamber web server running while the app is in the background." />
        </service>

        <!-- Phone control (experimental): keeps one short, natively confirmed lease visible with its
             Pause/Return controls while the person is in the controlled app. Independent from the
             runtime service and never started by the agent. -->
        <service
            android:name=".phone.android.overlay.PhoneOverlayDisplayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the short, user-enabled phone-control overlay and its stop controls while the user is in the controlled app." />
        </service>

        <service
            android:name=".phone.android.PhoneControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the short, user-confirmed phone-control session with its Pause and Return controls while the user is in another app." />
        </service>

        <!-- The notification's Return action. A direct Activity PendingIntent (not a service
             trampoline, which Android 12+ blocks). Invisible, not exported, never in history: it
             validates the nonce and lease epoch, revokes that lease, then opens AndChamber. -->
        <activity
            android:name=".phone.android.PhoneControlReturnActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The two RemoteInput replies of the pairing notification. Not exported: only our own
             notification's PendingIntent (explicit component) can reach it. It is a broadcast on
             purpose, so answering never opens an Activity and the system pairing dialog stays up. -->
        <receiver
            android:name=".phone.android.PhonePairingActionReceiver"
            android:exported="false" />
    </application>
</manifest>
