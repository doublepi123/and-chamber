<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is required: remote OpenChamber servers are reached over http on LAN, Tailscale
  and loopback addresses, which cannot be expressed as domain rules. Only system CAs are trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
