    <!-- OpenChamber and OpenCode updates -->
    <string name="update_available">Update available</string>
    <string name="update">Update</string>
    <string name="updating_title">Updating OpenChamber…</string>
    <string name="update_background_note">OpenChamber is unavailable until the update is done. You can leave the app. The update keeps going in the background and shows its progress in a notification.</string>
    <string name="update_dialog_title">Update OpenChamber?</string>
    <string name="update_dialog_body_running">OpenChamber stops during the update and starts again afterwards, so running tasks are interrupted. The update downloads up to a few hundred MB and takes several minutes. Projects and settings are kept, and if anything fails, the current version keeps working.</string>
    <string name="update_dialog_body">The update downloads up to a few hundred MB and takes several minutes. OpenChamber can\'t start until it\'s done. Projects and settings are kept, and if anything fails, the current version keeps working.</string>
    <string name="update_failed_title">The update didn\'t finish</string>
    <string name="update_failed_kept">The current version is still installed and works as before.</string>
