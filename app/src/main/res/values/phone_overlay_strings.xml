    <string name="phone_overlay_settings_title">Progress over other apps</string>
    <string name="phone_overlay_settings_off">Off · notifications only</string>
    <string name="phone_overlay_settings_on">On · overlay and notifications</string>
    <string name="phone_overlay_settings_selected_unchecked">Overlay selected · visibility not rechecked</string>
    <string name="phone_overlay_settings_selected_unchecked_hint">You chose the overlay, but it hasn\'t been tested since. Show the demo capsule again, or switch to notifications only.</string>
    <string name="phone_overlay_settings_selected_blocked">Overlay selected · can\'t be shown</string>
    <string name="phone_overlay_settings_selected_blocked_hint">The overlay isn\'t allowed or isn\'t available now, so it can\'t be shown. A task that relies on it is asked to stop; use AndChamber or its notification. Allow it again, or switch to notifications only.</string>
    <string name="phone_overlay_settings_intro">Shows a small capsule over the app the agent is using, so you can follow progress and take over without coming back here. The notification stays either way.</string>
    <string name="phone_overlay_settings_stop_kinds">Take over stops the agent observing and acting. Pause only stops new actions; the agent can still observe.</string>
    <string name="phone_overlay_settings_data">The capsule shows only status and the summary you wrote. It stays on this phone and isn\'t sent to the model. The agent can\'t turn it on, tap it, or use it to get access.</string>
    <string name="phone_overlay_settings_unavailable">Not available in this build yet. Notifications keep working.</string>
    <string name="phone_overlay_settings_permission">First allow AndChamber to \"Display over other apps\". On Android 11 and later the system may open the app list; find AndChamber there.</string>
    <string name="phone_overlay_settings_not_granted">Still not allowed. You can keep using notifications only.</string>
    <string name="phone_overlay_settings_open_system">Open system setting</string>
    <string name="phone_overlay_settings_recheck">Check again</string>
    <string name="phone_overlay_settings_test_body">Permission alone doesn\'t prove you can see it. Show a demo capsule and tap its Take over button. The demo controls nothing.</string>
    <string name="phone_overlay_settings_test_start">Show demo capsule</string>
    <string name="phone_overlay_settings_test_showing">Demo capsule requested. Tap its Take over button.</string>
    <string name="phone_overlay_settings_test_failed">The demo didn\'t work: the tap didn\'t arrive, or you didn\'t see it. Notifications only is still available.</string>
    <string name="phone_overlay_settings_confirm_q">The tap arrived. Did you see the demo capsule and press it yourself?</string>
    <string name="phone_overlay_settings_confirm_yes">Yes, I saw it</string>
    <string name="phone_overlay_settings_confirm_no">No</string>
    <string name="phone_overlay_settings_mode">Choose how to follow tasks</string>
    <string name="phone_overlay_settings_mode_overlay">Overlay and notifications</string>
    <string name="phone_overlay_settings_mode_notification">Notifications only</string>
    <string name="phone_overlay_settings_moved_to_notification">During the last task the overlay couldn\'t be shown, so its controls moved to the notification. Please check your notification shade.</string>
    <string name="phone_overlay_settings_test_note">The test shows it worked just now. The system can still hide the overlay later; then the agent is asked to stop and the notification remains.</string>
