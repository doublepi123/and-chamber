+import { afterEach, describe, expect, test } from 'bun:test';
+
+import { isAndroidBrowserProviderMode } from './hostCapability';
+import { readAndroidBrowserHost, readAndroidHostStateEvent, readAndroidHostTabs } from './androidHost';
+import { presentAndroidBrowserTab, selectAndroidHostTab, syncAndroidHostContext } from './androidHostSync';
+
+describe('android browser host mode', () => {
+  afterEach(() => {
+    Reflect.deleteProperty(globalThis, 'window');
+    Reflect.deleteProperty(globalThis, 'document');
+  });
+
+  test('comes from the server boot flag, not a user agent', () => {
+    Object.defineProperty(globalThis, 'window', {
+      value: { navigator: { userAgent: 'Android' } },
+      configurable: true,
+    });
+    expect(isAndroidBrowserProviderMode()).toBe(false);
+    window.__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__ = true;
+    expect(isAndroidBrowserProviderMode()).toBe(true);
+  });
+
+  test('reads a present/select/close host and never a token', () => {
+    const calls: string[] = [];
+    Object.defineProperty(globalThis, 'window', {
+      value: {
+        AndChamberBrowserHost: {
+          present: () => calls.push('present'),
+          select: () => calls.push('select'),
+          close: () => calls.push('close'),
+          tabs: () => [],
+        },
+      },
+      configurable: true,
+    });
+    const host = readAndroidBrowserHost();
+    expect(host).not.toBeNull();
+    expect('token' in (host ?? {})).toBe(false);
+    expect('claimNonce' in (host ?? {})).toBe(false);
+  });
+
+  test('parses a JSON string from tabs() into an array', () => {
+    const tabs = readAndroidHostTabs(JSON.stringify([
+      { tabId: 'native-1', url: 'https://example.test/', title: 'Example', ownerSessionId: 'ses_1' },
+    ]));
+    expect(tabs).toEqual([
+      { tabId: 'native-1', title: 'Example', url: 'https://example.test/', ownerSessionId: 'ses_1', active: false },
+    ]);
+    expect(Array.isArray(tabs)).toBe(true);
+  });
+
+  test('state event detail uses the same tab schema', () => {
+    const event = new Event('andchamber-browser-host-state');
+    Object.assign(event, {
+      detail: [{ tabId: 'native-1', title: 'Example', url: 'https://example.test/', ownerSessionId: 'ses_1', active: true }],
+    });
+    expect(readAndroidHostStateEvent(event)[0]).toMatchObject({
+      tabId: 'native-1',
+      ownerSessionId: 'ses_1',
+      active: true,
+    });
+  });
+
+  test('user present sends url and owner only, and context is optional', () => {
+    const presented: unknown[] = [];
+    const contexts: unknown[] = [];
+    Object.defineProperty(globalThis, 'window', {
+      value: {
+        AndChamberBrowserHost: {
+          present: (request: unknown) => presented.push(request),
+          select: () => undefined,
+          close: () => undefined,
+          tabs: () => [],
+          context: (context: unknown) => contexts.push(context),
+        },
+      },
+      configurable: true,
+    });
+    presentAndroidBrowserTab('https://example.test/', 'ses_1');
+    syncAndroidHostContext({ sessionId: 'ses_2', directory: '/repo' });
+    expect(presented).toEqual([{ url: 'https://example.test/', ownerSessionId: 'ses_1' }]);
+    expect(contexts).toEqual([{ sessionId: 'ses_2', directory: '/repo' }]);
+    expect(JSON.stringify(presented)).not.toContain('grant');
+    expect(presentAndroidBrowserTab('   ', 'ses_1')).toBe(false);
+    expect(presented).toHaveLength(1);
+  });
+
+  test('does not select an invisible tab or present while selecting', () => {
+    const calls: string[] = [];
+    Object.defineProperty(globalThis, 'window', {
+      value: {
+        AndChamberBrowserHost: {
+          present: () => calls.push('present'),
+          select: () => calls.push('select'),
+          close: () => undefined,
+          tabs: () => [{ tabId: 'native-1', title: '', url: 'https://example.test/', ownerSessionId: 'ses_1', active: true }],
+        },
+      },
+      configurable: true,
+    });
+    const state = {
+      openAgentBrowserTab: () => 'native-1',
+      setActiveContextPanelTab: () => undefined,
+      closeContextPanelTab: () => undefined,
+      contextPanelByDirectory: {},
+    };
+    selectAndroidHostTab('native-1', false, '/repo', state);
+    expect(calls).toEqual([]);
+    selectAndroidHostTab('native-1', true, '/repo', state);
+    expect(calls).toEqual(['select']);
+  });
+});
diff --git a/packages/ui/src/lib/browser/androidHost.ts b/packages/ui/src/lib/browser/androidHost.ts
new file mode 100644
index 0000000..7d29649
--- /dev/null
+++ b/packages/ui/src/lib/browser/androidHost.ts
@@ -0,0 +1,95 @@
+/**
+ * Typed presentation bridge for the Android exclusive browser.
+ *
+ * The native host may present, select and close a tab, and mirror tab metadata.
+ * It never receives the provider token, a claim nonce, or a grant, and it is
+ * not asked to evaluate a page. Authority stays on the Kotlin SSE client.
+ */
+
+/** Wire schema shared with the Android presenter. ownerSessionId is ownership, not a grant. */
+export type AndroidHostTab = {
+  readonly tabId: string;
+  readonly title: string;
+  readonly url: string;
+  readonly ownerSessionId: string | null;
+  readonly active: boolean;
+};
+
+export type AndroidHostPresentRequest = {
+  readonly url: string;
+  readonly ownerSessionId: string | null;
+};
+
+export type AndroidHostContext = {
+  readonly sessionId: string | null;
+  readonly directory: string | null;
+};
+
+export type AndroidBrowserHost = {
+  /** User Browser entry: Android creates the page. Does not grant. */
+  readonly present: (request: AndroidHostPresentRequest) => void;
+  readonly select: (tabId: string) => void;
+  readonly close: (tabId: string) => void;
+  /** A real array, or a JSON string of that array. Never a grant or token. */
+  readonly tabs: () => readonly AndroidHostTab[] | string;
+  /** Optional. A session change asks Android to revoke; absence is a no-op. */
+  readonly context?: (context: AndroidHostContext) => void;
+};
+
+export const ANDROID_BROWSER_HOST_READY_EVENT = 'andchamber-browser-host-ready';
+export const ANDROID_BROWSER_HOST_STATE_EVENT = 'andchamber-browser-host-state';
+
+const isTab = (value: unknown): value is AndroidHostTab => {
+  if (!value || typeof value !== 'object') return false;
+  const tab = value as Partial<AndroidHostTab> & { id?: unknown; owner?: unknown };
+  const tabId = typeof tab.tabId === 'string' ? tab.tabId : typeof tab.id === 'string' ? tab.id : '';
+  return tabId.length > 0 && typeof tab.url === 'string';
+};
+
+/**
+ * Kotlin's wrapper JSON-encodes the return value. A string is parsed once;
+ * anything that is not a tab array becomes an empty list.
+ */
+const tabFrom = (value: AndroidHostTab & { id?: string; owner?: string | null; directory?: string }): AndroidHostTab & { directory?: string } => {
+  const owner = value.ownerSessionId ?? value.owner;
+  return {
+    tabId: value.tabId || value.id || '',
+    title: typeof value.title === 'string' ? value.title : '',
+    url: value.url,
+    ownerSessionId: typeof owner === 'string' && owner ? owner : null,
+    active: value.active === true,
+    ...(typeof value.directory === 'string' ? { directory: value.directory } : {}),
+  };
+};
+
+export const readAndroidHostTabs = (value: readonly AndroidHostTab[] | string | null | undefined): readonly AndroidHostTab[] => {
+  const parsed = typeof value === 'string'
+    ? (() => { try { return JSON.parse(value) as unknown; } catch { return null; } })()
+    : value;
+  if (!Array.isArray(parsed)) return [];
+  return parsed.filter(isTab).map((tab) => tabFrom(tab));
+};
+
+/** State events carry the same array, either as detail or detail.tabs. */
+export const readAndroidHostStateEvent = (event: Event): readonly AndroidHostTab[] => {
+  const detail = (event as CustomEvent<unknown>).detail;
+  if (Array.isArray(detail) || typeof detail === 'string') return readAndroidHostTabs(detail);
+  if (detail && typeof detail === 'object' && 'tabs' in detail) {
+    return readAndroidHostTabs((detail as { tabs?: readonly AndroidHostTab[] | string }).tabs);
+  }
+  return [];
+};
+
+const isHost = (value: unknown): value is AndroidBrowserHost => {
+  if (!value || typeof value !== 'object') return false;
+  const host = value as Partial<AndroidBrowserHost>;
+  return typeof host.present === 'function'
+    && typeof host.select === 'function'
+    && typeof host.close === 'function'
+    && typeof host.tabs === 'function';
+};
+
+export const readAndroidBrowserHost = (): AndroidBrowserHost | null => {
+  if (typeof window === 'undefined') return null;
+  return isHost(window.AndChamberBrowserHost) ? window.AndChamberBrowserHost : null;
+};
