@@ -0,0 +1,16 @@
+/**
+ * Reads the server boot flag before the app bundle evaluates.
+ *
+ * The flag is injected into the document by the server that was launched with
+ * OPENCHAMBER_BROWSER_PROVIDER=android. It is not a user-agent check, and it
+ * never carries the provider token.
+ */
+export const applyAndroidBrowserBootFlag = (): boolean => {
+  if (typeof document === 'undefined') return false;
+  const marker = document.documentElement.getAttribute('data-openchamber-android-browser');
+  if (marker === 'true') {
+    window.__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__ = true;
+    return true;
+  }
+  return window.__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__ === true;
+};
