@@ -0,0 +1,135 @@
+/**
+ * Mirrors native Android tabs into the existing context-panel tab store.
+ *
+ * The native tab id is the store id. present/select only choose that tab;
+ * they do not grant authority and they do not ask the host to load again.
+ */
+import { normalizeContextPanelDirectoryKey, useUIStore } from '@/stores/useUIStore';
+import {
+  ANDROID_BROWSER_HOST_READY_EVENT,
+  ANDROID_BROWSER_HOST_STATE_EVENT,
+  readAndroidBrowserHost,
+  readAndroidHostStateEvent,
+  readAndroidHostTabs,
+  type AndroidHostContext,
+  type AndroidHostTab,
+} from './androidHost';
+
+type MirrorState = {
+  readonly openAgentBrowserTab: (directory: string, url: string, ownerSessionId: string | null, tabId?: string | null) => string | null;
+  readonly setActiveContextPanelTab: (directory: string, tabId: string) => void;
+  readonly closeContextPanelTab: (directory: string, tabId: string) => void;
+  readonly contextPanelByDirectory: Record<string, { tabs: ReadonlyArray<{ id: string; mode: string; targetPath: string | null; ownerSessionId: string | null }> }>;
+};
+
+const mirrored = new Map<string, { directory: string; url: string }>();
+let selectedTabId: string | null = null;
+
+const directoryOf = (tab: AndroidHostTab & { directory?: string }, fallback: string): string => (
+  tab.directory ? normalizeContextPanelDirectoryKey(tab.directory) : fallback
+);
+
+export const mirrorAndroidHostTabs = (
+  tabs: readonly AndroidHostTab[],
+  fallbackDirectory: string,
+  state: MirrorState = useUIStore.getState(),
+): void => {
+  const seen = new Set<string>();
+  for (const tab of tabs) {
+    const directory = directoryOf(tab, fallbackDirectory);
+    if (!directory || !tab.tabId) continue;
+    seen.add(tab.tabId);
+    const existing = state.contextPanelByDirectory[directory]?.tabs.find((candidate) => candidate.id === tab.tabId);
+    const previous = mirrored.get(tab.tabId);
+    if (!existing) {
+      state.openAgentBrowserTab(directory, tab.url, tab.ownerSessionId, tab.tabId);
+    }
+    mirrored.set(tab.tabId, { directory, url: tab.url });
+    if (previous && previous.directory !== directory) {
+      state.closeContextPanelTab(previous.directory, tab.tabId);
+    }
+  }
+  for (const [tabId, previous] of [...mirrored.entries()]) {
+    if (seen.has(tabId)) continue;
+    mirrored.delete(tabId);
+    state.closeContextPanelTab(previous.directory, tabId);
+  }
+};
+
+/**
+ * Shows a tab the store already has. A missing tab is mirrored once from the
+ * host list; present is not called, so this cannot grant or reload.
+ */
+export const selectAndroidHostTab = (
+  tabId: string,
+  visible: boolean,
+  fallbackDirectory: string,
+  state: MirrorState = useUIStore.getState(),
+): void => {
+  if (!visible || !tabId) return;
+  const host = readAndroidBrowserHost();
+  if (host) mirrorAndroidHostTabs(readAndroidHostTabs(host.tabs()), fallbackDirectory, state);
+  const directory = mirrored.get(tabId)?.directory || fallbackDirectory;
+  if (!directory) return;
+  state.setActiveContextPanelTab(directory, tabId);
+  // select displays the native tab. It does not navigate or grant. Repeating
+  // it for the same tab would look like another present/load.
+  if (selectedTabId === tabId) return;
+  selectedTabId = tabId;
+  readAndroidBrowserHost()?.select(tabId);
+};
+
+export const subscribeAndroidHost = (
+  fallbackDirectory: string,
+  onChange: () => void,
+): (() => void) => {
+  if (typeof window === 'undefined') return () => undefined;
+  const refresh = () => {
+    const host = readAndroidBrowserHost();
+    if (host) mirrorAndroidHostTabs(readAndroidHostTabs(host.tabs()), fallbackDirectory);
+    onChange();
+  };
+  const onState = (event: Event) => {
+    const tabs = readAndroidHostStateEvent(event);
+    if (tabs.length > 0 || Array.isArray((event as CustomEvent<unknown>).detail)) {
+      mirrorAndroidHostTabs(tabs, fallbackDirectory);
+    } else {
+      refresh();
+      return;
+    }
+    onChange();
+  };
+  window.addEventListener(ANDROID_BROWSER_HOST_READY_EVENT, refresh);
+  window.addEventListener(ANDROID_BROWSER_HOST_STATE_EVENT, onState);
+  refresh();
+  return () => {
+    window.removeEventListener(ANDROID_BROWSER_HOST_READY_EVENT, refresh);
+    window.removeEventListener(ANDROID_BROWSER_HOST_STATE_EVENT, onState);
+  };
+};
+
+/**
+ * Tells Android which chat is current. ownerSessionId on a later present is
+ * still only ownership. A host without context is left alone.
+ */
+export const syncAndroidHostContext = (context: AndroidHostContext): void => {
+  const host = readAndroidBrowserHost();
+  if (!host || typeof host.context !== 'function') return;
+  host.context({
+    sessionId: context.sessionId ?? '',
+    directory: context.directory,
+  });
+};
+
+/**
+ * User Browser entry. Android creates the page; this does not grant.
+ * An empty URL is refused here so the native host never sees one.
+ */
+export const presentAndroidBrowserTab = (url: string, ownerSessionId: string | null): boolean => {
+  const trimmed = url.trim();
+  if (!trimmed) return false;
+  const host = readAndroidBrowserHost();
+  if (!host) return false;
+  host.present({ url: trimmed, ownerSessionId });
+  return true;
+};
