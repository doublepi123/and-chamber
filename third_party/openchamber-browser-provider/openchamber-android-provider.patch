+import React from 'react';
+
+import { normalizeContextPanelDirectoryKey } from '@/stores/useUIStore';
+import { useDirectoryStore } from '@/stores/useDirectoryStore';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+
+import { isAndroidBrowserProviderMode } from './hostCapability';
+import { syncAndroidHostContext } from './androidHostSync';
+
+/**
+ * Android must hear every chat change, including leaving a chat, even when
+ * the Browser pane has never been opened. Desktop and mobile both call this
+ * from a root that stays mounted. The same session and directory are sent
+ * once; a later mount of another caller does not repeat it.
+ *
+ * Directory is the current session's directory, then the app directory.
+ * Neither requires the sync runtime, so the mobile shell can call this
+ * before a session list is mounted.
+ */
+let lastSentKey: string | null = null;
+
+export const resetAndroidHostContextSync = (): void => {
+  lastSentKey = null;
+};
+
+export const useAndroidHostContextSync = (): void => {
+  const sessionId = useSessionUIStore((state) => state.currentSessionId);
+  const sessionDirectory = useSessionUIStore((state) => state.currentSessionDirectory);
+  const appDirectory = useDirectoryStore((state) => state.currentDirectory);
+  const directory = sessionDirectory || appDirectory || '';
+  const directoryKey = React.useMemo(
+    () => (directory ? normalizeContextPanelDirectoryKey(directory) : ''),
+    [directory],
+  );
+
+  React.useEffect(() => {
+    if (!isAndroidBrowserProviderMode()) return;
+    const nextSessionId = sessionId ?? '';
+    const nextDirectory = directoryKey || null;
+    const key = `${nextSessionId}\n${nextDirectory ?? ''}`;
+    if (lastSentKey === key) return;
+    lastSentKey = key;
+    syncAndroidHostContext({ sessionId: nextSessionId, directory: nextDirectory });
+  }, [directoryKey, sessionId]);
+};
diff --git a/packages/web/server/lib/browser-control/android-provider.js b/packages/web/server/lib/browser-control/android-provider.js
new file mode 100644
index 0000000..573cf17
--- /dev/null
+++ b/packages/web/server/lib/browser-control/android-provider.js
@@ -0,0 +1,383 @@
+/**
+ * Exclusive Android browser provider binding.
+ *
+ * AndChamber launches this server with OPENCHAMBER_BROWSER_PROVIDER=android and
+ * a per-launch ANDCHAMBER_BROWSER_PROVIDER_TOKEN. The token is captured into a
+ * private closure and deleted from process.env before any child is spawned.
+ * Kotlin is the only claim/result executor: requests are written to that one
+ * provider SSE connection, never broadcast to UI clients.
+ *
+ * SSE connection is transport, not authority. A grant lives in the native
+ * client; this module only binds requestId, connectionId and claimNonce.
+ */
+
+import crypto from 'node:crypto';
+
+import { isLoopbackBindHost } from '../security/bind-host.js';
+
+export const ANDROID_BROWSER_PROVIDER = 'android';
+export const ANDROID_PROVIDER_TOKEN_ENV = 'ANDCHAMBER_BROWSER_PROVIDER_TOKEN';
+export const ANDROID_PROVIDER_MODE_ENV = 'OPENCHAMBER_BROWSER_PROVIDER';
+export const ANDROID_PROVIDER_TOKEN_HEADER = 'x-andchamber-browser-token';
+export const ANDROID_PROVIDER_PROTOCOL_VERSION = 1;
+
+export const ANDROID_PROVIDER_ERROR_CODES = Object.freeze({
+  UNAVAILABLE: 'ANDROID_PROVIDER_UNAVAILABLE',
+  AUTH_REQUIRED: 'ANDROID_PROVIDER_AUTH_REQUIRED',
+  REJECTED: 'ANDROID_PROVIDER_REJECTED',
+  BUSY: 'ANDROID_PROVIDER_BUSY',
+  DISCONNECTED: 'ANDROID_PROVIDER_DISCONNECTED',
+  PROTOCOL: 'ANDROID_PROVIDER_PROTOCOL_ERROR',
+});
+
+const TOKEN_BYTES = 32;
+
+/**
+ * The provider token must never reach a child, including OpenCode. Compared
+ * case-insensitively because Windows env lookups are case-insensitive.
+ * Other process secrets have their own filters; this one only owns the token.
+ */
+
+export const isAndroidBrowserProviderMode = (value) => (
+  typeof value === 'string' && value.trim().toLowerCase() === ANDROID_BROWSER_PROVIDER
+);
+
+/**
+ * Drops the provider token (and other process secrets) from an environment
+ * object that is about to be handed to a child. Returns a new object.
+ */
+export const omitProviderTokenFromEnv = (source) => {
+  if (!source || typeof source !== 'object') return {};
+  let stripped = false;
+  const env = {};
+  for (const [name, value] of Object.entries(source)) {
+    if (name.toUpperCase() === ANDROID_PROVIDER_TOKEN_ENV) {
+      stripped = true;
+      continue;
+    }
+    env[name] = value;
+  }
+  return stripped ? env : source;
+};
+
+const headerValue = (headers, name) => {
+  if (!headers || typeof headers !== 'object') return '';
+  const raw = headers[name] ?? headers[name.toLowerCase()];
+  const value = Array.isArray(raw) ? raw[0] : raw;
+  return typeof value === 'string' ? value : '';
+};
+
+const originHeader = (req) => headerValue(req?.headers, 'origin');
+
+const peerAddress = (req) => {
+  const raw = req?.socket?.remoteAddress ?? req?.connection?.remoteAddress ?? '';
+  return typeof raw === 'string' ? raw : '';
+};
+
+const tokensMatch = (provided, expected) => {
+  if (typeof provided !== 'string' || typeof expected !== 'string') return false;
+  const left = Buffer.from(provided);
+  const right = Buffer.from(expected);
+  if (left.length === 0 || left.length !== right.length) return false;
+  return crypto.timingSafeEqual(left, right);
+};
+
+/**
+ * Captures the launch token once. Later reads of process.env cannot recover it.
+ */
+export const captureAndroidProviderToken = (env = process.env) => {
+  const mode = typeof env?.[ANDROID_PROVIDER_MODE_ENV] === 'string' ? env[ANDROID_PROVIDER_MODE_ENV] : '';
+  const raw = typeof env?.[ANDROID_PROVIDER_TOKEN_ENV] === 'string' ? env[ANDROID_PROVIDER_TOKEN_ENV] : '';
+  const enabled = isAndroidBrowserProviderMode(mode);
+  let token = null;
+  let invalid = false;
+  if (enabled) {
+    const trimmed = raw.trim();
+    if (trimmed.length >= TOKEN_BYTES && trimmed === raw && !/[\r\n\0]/.test(trimmed)) {
+      token = trimmed;
+    } else {
+      invalid = true;
+    }
+  }
+  if (env && Object.prototype.hasOwnProperty.call(env, ANDROID_PROVIDER_TOKEN_ENV)) {
+    delete env[ANDROID_PROVIDER_TOKEN_ENV];
+  }
+  return {
+    enabled: enabled && token !== null,
+    configured: enabled,
+    invalid,
+    token,
+  };
+};
+
+/**
+ * Loopback peer, no Origin, header token. UI cookies and browser=1 never substitute.
+ * `redirect: 'manual'` is a client concern; this server never redirects these routes.
+ */
+export const authorizeAndroidProviderRequest = (req, expectedToken) => {
+  if (!expectedToken) {
+    return { ok: false, status: 503, code: ANDROID_PROVIDER_ERROR_CODES.UNAVAILABLE, error: 'Android browser provider is not configured' };
+  }
+  if (!isLoopbackBindHost(peerAddress(req))) {
+    return { ok: false, status: 403, code: ANDROID_PROVIDER_ERROR_CODES.AUTH_REQUIRED, error: 'Android browser provider requires a loopback peer' };
+  }
+  if (originHeader(req)) {
+    return { ok: false, status: 403, code: ANDROID_PROVIDER_ERROR_CODES.AUTH_REQUIRED, error: 'Android browser provider rejects Origin' };
+  }
+  const provided = headerValue(req?.headers, ANDROID_PROVIDER_TOKEN_HEADER).trim();
+  if (!tokensMatch(provided, expectedToken)) {
+    return { ok: false, status: 401, code: ANDROID_PROVIDER_ERROR_CODES.AUTH_REQUIRED, error: 'Android browser provider token is required' };
+  }
+  return { ok: true };
+};
+
+const monotonicNow = () => Number(process.hrtime.bigint() / 1_000_000n);
+
+export const createAndroidProviderRegistry = ({
+  enabled = false,
+  token = null,
+  createId = () => crypto.randomUUID(),
+  now = monotonicNow,
+  wallNow = Date.now,
+  setTimer = setTimeout,
+  clearTimer = clearTimeout,
+} = {}) => {
+  let connection = null;
+  const pending = new Map();
+
+  const writeEvent = (client, event) => {
+    if (!client || client.writableEnded || client.destroyed) return false;
+    try {
+      client.write(`data: ${JSON.stringify(event)}\n\n`);
+      return true;
+    } catch {
+      return false;
+    }
+  };
+
+  const notifyCancel = (entry, requestId, reason) => {
+    if (!entry || !connection || connection.connectionId !== entry.connectionId) return false;
+    return writeEvent(connection.client, {
+      type: 'openchamber:browser-control-cancel',
+      properties: {
+        protocolVersion: ANDROID_PROVIDER_PROTOCOL_VERSION,
+        serverEpoch: entry.serverEpoch,
+        connectionId: entry.connectionId,
+        requestId,
+        reason,
+      },
+    });
+  };
+
+  const failPending = (predicate, outcome) => {
+    for (const [requestId, entry] of [...pending.entries()]) {
+      if (!predicate(entry, requestId)) continue;
+      pending.delete(requestId);
+      if (entry.timer) clearTimer(entry.timer);
+      entry.finish(outcome);
+    }
+  };
+
+  const detach = (client, message) => {
+    if (!connection || connection.client !== client) return false;
+    const connectionId = connection.connectionId;
+    connection = null;
+    try { client.end(); } catch { /* already gone */ }
+    failPending(
+      (entry) => entry.connectionId === connectionId,
+      { ok: false, code: ANDROID_PROVIDER_ERROR_CODES.DISCONNECTED, message, status: 503 },
+    );
+    return true;
+  };
+
+  return {
+    get enabled() {
+      return enabled === true && typeof token === 'string' && token.length > 0;
+    },
+
+    get token() {
+      return token;
+    },
+
+    get connectionId() {
+      return connection?.connectionId ?? null;
+    },
+
+    get serverEpoch() {
+      return connection?.serverEpoch ?? null;
+    },
+
+    get connected() {
+      return connection !== null;
+    },
+
+    authorize(req) {
+      if (!this.enabled) {
+        return { ok: false, status: 503, code: ANDROID_PROVIDER_ERROR_CODES.UNAVAILABLE, error: 'Android browser provider is not configured' };
+      }
+      return authorizeAndroidProviderRequest(req, token);
+    },
+
+    /**
+     * Attaches the single provider SSE. A second live connection is rejected;
+     * a replacement is not accepted until the first closes.
+     */
+    attach(req, res) {
+      if (connection) {
+        return { ok: false, status: 409, code: ANDROID_PROVIDER_ERROR_CODES.BUSY, error: 'An Android browser provider is already connected' };
+      }
+      const connectionId = createId();
+      const serverEpoch = createId();
+      res.setHeader('Content-Type', 'text/event-stream; charset=utf-8');
+      res.setHeader('Cache-Control', 'no-cache, no-transform');
+      res.setHeader('Connection', 'keep-alive');
+      res.setHeader('X-Accel-Buffering', 'no');
+      res.flushHeaders?.();
+      res.openchamberAndroidProvider = true;
+      res.openchamberConnectionId = connectionId;
+      connection = { client: res, connectionId, serverEpoch, connectedAt: wallNow() };
+      const ready = writeEvent(res, {
+        type: 'openchamber:event-stream-ready',
+        properties: {
+          protocolVersion: ANDROID_PROVIDER_PROTOCOL_VERSION,
+          serverEpoch,
+          connectionId,
+        },
+      });
+      if (!ready) {
+        connection = null;
+        return { ok: false, status: 500, code: ANDROID_PROVIDER_ERROR_CODES.PROTOCOL, error: 'Android browser provider stream could not start' };
+      }
+      const heartbeat = setInterval(() => {
+        if (!writeEvent(res, { type: 'openchamber:heartbeat', properties: { timestamp: wallNow() } })) {
+          clearInterval(heartbeat);
+          detach(res, 'The Android browser provider disconnected');
+        }
+      }, 25_000);
+      heartbeat.unref?.();
+      req.on('close', () => {
+        clearInterval(heartbeat);
+        detach(res, 'The Android browser provider disconnected');
+      });
+      return { ok: true, connectionId, serverEpoch };
+    },
+
+    /**
+     * Registers the pending request before the caller emits it. The returned
+     * envelope is the only payload that may be written to the provider.
+     */
+    beginRequest({ requestId, action, parameters, context, timeoutMs, setTimer: requestSetTimer = setTimer, clearTimer: requestClearTimer = clearTimer }) {
+      if (!connection) return { delivered: 0 };
+      const current = connection;
+      const started = now();
+      const bounded = Math.min(Math.max(1_000, Number(timeoutMs) || 20_000), 120_000);
+      const claimNonce = crypto.randomBytes(24).toString('base64url');
+      const envelope = {
+        protocolVersion: ANDROID_PROVIDER_PROTOCOL_VERSION,
+        serverEpoch: current.serverEpoch,
+        connectionId: current.connectionId,
+        requestId,
+        action,
+        parameters,
+        context,
+        deadlineAtEpochMs: wallNow() + bounded,
+        timeoutMs: bounded,
+      };
+      return {
+        delivered: 1,
+        envelope,
+        hold(finish) {
+          if (connection !== current) {
+            finish({ ok: false, code: ANDROID_PROVIDER_ERROR_CODES.DISCONNECTED, message: 'The Android browser provider disconnected', status: 503 });
+            return;
+          }
+          const entry = {
+            connectionId: current.connectionId,
+            serverEpoch: current.serverEpoch,
+            claimNonce,
+            claimed: false,
+            started,
+            timeoutMs: bounded,
+            timer: null,
+            finish,
+            expired: false,
+          };
+          const settleTimeout = () => {
+            const currentEntry = pending.get(requestId);
+            if (!currentEntry || currentEntry !== entry) return;
+            pending.delete(requestId);
+            entry.expired = true;
+            notifyCancel(entry, requestId, 'timeout');
+            entry.finish({
+              ok: false,
+              code: 'ANDROID_PROVIDER_TIMEOUT',
+              message: `The Android browser provider did not respond within ${Math.round(bounded / 1000)}s`,
+              status: 504,
+            });
+          };
+          entry.timer = requestSetTimer(settleTimeout, bounded);
+          entry.timer.unref?.();
+          pending.set(requestId, entry);
+        },
+      };
+    },
+
+    emit(envelope) {
+      if (!connection || connection.connectionId !== envelope.connectionId) return false;
+      return writeEvent(connection.client, {
+        type: 'openchamber:browser-control-request',
+        properties: envelope,
+      });
+    },
+
+    claim({ requestId, connectionId }) {
+      const entry = pending.get(requestId);
+      if (!entry || entry.expired || entry.claimed) return { granted: false };
+      if (entry.connectionId !== connectionId) return { granted: false };
+      if (!connection || connection.connectionId !== connectionId) return { granted: false };
+      const elapsed = now() - entry.started;
+      const remainingMs = Math.max(0, entry.timeoutMs - elapsed);
+      if (remainingMs <= 0) return { granted: false };
+      entry.claimed = true;
+      return { granted: true, claimNonce: entry.claimNonce, remainingMs };
+    },
+
+    /**
+     * Settles only a claimed request whose connection and nonce match.
+     * A wrong connection or nonce cannot settle. A late match after timeout
+     * returns matched:false. An error result still settles the waiting caller.
+     */
+    result({ requestId, connectionId, claimNonce, ok, data, error }) {
+      const entry = pending.get(requestId);
+      if (!entry) return { matched: false };
+      if (entry.connectionId !== connectionId || entry.claimNonce !== claimNonce || !entry.claimed) {
+        return { matched: false, settled: false };
+      }
+      pending.delete(requestId);
+      if (entry.timer) clearTimer(entry.timer);
+      entry.finish(ok === true
+        ? { ok: true, data: data ?? null }
+        : {
+          ok: false,
+          code: typeof error === 'string' && error ? error : 'ANDROID_PROVIDER_RESULT_ERROR',
+          message: typeof error === 'string' && error ? error : 'Android browser provider reported a failure',
+          status: 400,
+        });
+      return { matched: true };
+    },
+
+    cancel(requestId, message, reason = 'abort') {
+      const entry = pending.get(requestId);
+      if (!entry) return false;
+      pending.delete(requestId);
+      if (entry.timer) clearTimer(entry.timer);
+      notifyCancel(entry, requestId, reason);
+      entry.finish({ ok: false, code: 'ANDROID_PROVIDER_CANCELLED', message, status: 499 });
+      return true;
+    },
+
+    rejectAll(message = 'The Android browser provider disconnected') {
+      failPending(() => true, { ok: false, code: ANDROID_PROVIDER_ERROR_CODES.DISCONNECTED, message, status: 503 });
+    },
+  };
+};
diff --git a/packages/web/server/lib/browser-control/android-provider.test.js b/packages/web/server/lib/browser-control/android-provider.test.js
