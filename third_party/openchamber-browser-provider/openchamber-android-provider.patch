index 0000000..d456644
--- /dev/null
+++ b/packages/web/server/lib/browser-control/android-provider.test.js
@@ -0,0 +1,379 @@
+import http from 'node:http';
+import { once } from 'node:events';
+import express from 'express';
+import request from 'supertest';
+import { describe, expect, test } from 'bun:test';
+
+import {
+  ANDROID_PROVIDER_TOKEN_ENV,
+  authorizeAndroidProviderRequest,
+  captureAndroidProviderToken,
+  createAndroidProviderRegistry,
+  omitProviderTokenFromEnv,
+} from './android-provider.js';
+import { childProcessEnv } from './child-env.js';
+import { BrowserControlError, createBrowserControlBroker } from './broker.js';
+import { registerBrowserControlRoutes } from './routes.js';
+import { createBrowserControlRouter } from './provider.js';
+import { registerAuthAndAccessRoutes } from '../opencode/core-routes.js';
+
+const TOKEN = 'a'.repeat(43);
+
+const loopbackReq = (headers = {}, address = '127.0.0.1') => ({
+  headers,
+  socket: { remoteAddress: address },
+});
+
+describe('android provider token', () => {
+  test('captures the launch token and deletes it from the environment', () => {
+    const env = {
+      OPENCHAMBER_BROWSER_PROVIDER: 'android',
+      [ANDROID_PROVIDER_TOKEN_ENV]: TOKEN,
+      PATH: '/usr/bin',
+    };
+    const captured = captureAndroidProviderToken(env);
+    expect(captured.enabled).toBe(true);
+    expect(captured.token).toBe(TOKEN);
+    expect(env[ANDROID_PROVIDER_TOKEN_ENV]).toBeUndefined();
+    expect(env.PATH).toBe('/usr/bin');
+  });
+
+  test('does not enable Android mode without a usable token', () => {
+    const env = { OPENCHAMBER_BROWSER_PROVIDER: 'android', [ANDROID_PROVIDER_TOKEN_ENV]: 'short' };
+    expect(captureAndroidProviderToken(env).enabled).toBe(false);
+    expect(env[ANDROID_PROVIDER_TOKEN_ENV]).toBeUndefined();
+  });
+
+  test('omits the token from every child environment copy and leaves OpenCode secrets to their own filters', () => {
+    const source = {
+      PATH: '/usr/bin',
+      [ANDROID_PROVIDER_TOKEN_ENV]: TOKEN,
+      andchamber_browser_provider_token: TOKEN,
+      OPENCODE_SERVER_PASSWORD: 'password',
+    };
+    expect(omitProviderTokenFromEnv(source)).toEqual({ PATH: '/usr/bin', OPENCODE_SERVER_PASSWORD: 'password' });
+    expect(childProcessEnv(source)).toEqual({ PATH: '/usr/bin', OPENCODE_SERVER_PASSWORD: 'password' });
+    const clean = { PATH: '/usr/bin' };
+    expect(omitProviderTokenFromEnv(clean)).toBe(clean);
+  });
+});
+
+describe('android provider auth', () => {
+  test('requires loopback, no Origin, and a constant-time token match', () => {
+    expect(authorizeAndroidProviderRequest(loopbackReq({ 'x-andchamber-browser-token': TOKEN }), TOKEN).ok).toBe(true);
+    expect(authorizeAndroidProviderRequest(loopbackReq({ 'x-andchamber-browser-token': TOKEN, origin: 'http://127.0.0.1:3000' }), TOKEN).status).toBe(403);
+    expect(authorizeAndroidProviderRequest(loopbackReq({ 'x-andchamber-browser-token': TOKEN }, '192.0.2.10'), TOKEN).status).toBe(403);
+    expect(authorizeAndroidProviderRequest(loopbackReq({ 'x-andchamber-browser-token': 'wrong-token-value-of-same-length-pad' }), TOKEN).status).toBe(401);
+    expect(authorizeAndroidProviderRequest(loopbackReq({ cookie: 'oc_session=1' }), TOKEN).status).toBe(401);
+  });
+});
+
+const readSse = async (server, headers) => {
+  const address = server.address();
+  const req = http.request({
+    hostname: '127.0.0.1',
+    port: address.port,
+    path: '/api/openchamber/events?provider=android',
+    headers,
+  });
+  req.end();
+  const [res] = await once(req, 'response');
+  let body = '';
+  const ready = new Promise((resolve, reject) => {
+    res.on('data', (chunk) => {
+      body += chunk.toString();
+      if (body.includes('event-stream-ready')) resolve(body);
+    });
+    res.on('error', reject);
+  });
+  return { res, ready, request: req };
+};
+
+describe('android provider SSE and broker binding', () => {
+  test('targets one connection and rejects a second provider', async () => {
+    const registry = createAndroidProviderRegistry({ enabled: true, token: TOKEN, createId: (() => {
+      let n = 0;
+      return () => `id-${++n}`;
+    })() });
+    const app = express();
+    app.get('/api/openchamber/events', (req, res) => {
+      const attached = registry.attach(req, res);
+      if (!attached.ok && !res.headersSent) res.status(attached.status).json(attached);
+    });
+    const server = app.listen(0, '127.0.0.1');
+    await once(server, 'listening');
+    try {
+      const first = await readSse(server, { 'x-andchamber-browser-token': TOKEN });
+      const ready = await first.ready;
+      expect(ready).toContain('"protocolVersion":1');
+      expect(ready).toContain('"serverEpoch":"id-2"');
+      expect(ready).toContain('"connectionId":"id-1"');
+
+      const address = server.address();
+      const second = await fetch(`http://127.0.0.1:${address.port}/api/openchamber/events?provider=android`, {
