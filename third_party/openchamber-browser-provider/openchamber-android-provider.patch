+import React from 'react';
+
+import { Button } from '@/components/ui/button';
+import { readAndroidBrowserHost, readAndroidHostStateEvent, readAndroidHostTabs, type AndroidHostTab } from '@/lib/browser/androidHost';
+import { presentAndroidBrowserTab, selectAndroidHostTab, subscribeAndroidHost } from '@/lib/browser/androidHostSync';
+import { normalizeBrowserUrl } from '@/lib/browser/url';
+import { normalizeContextPanelDirectoryKey } from '@/stores/useUIStore';
+import type { BrowserPaneProps } from './BrowserPane';
+
+/**
+ * Android exclusive presentation. No iframe and no Electron webview.
+ * Selecting a visible tab only mirrors the native registry into the existing
+ * tab store. It does not call present, so it cannot grant or reload.
+ */
+export const AndroidHostBrowser: React.FC<BrowserPaneProps> = ({ initialUrl, directory, tabID, ownerSessionId, visible }) => {
+  const [hostMissing, setHostMissing] = React.useState(() => readAndroidBrowserHost() === null);
+  const [tabs, setTabs] = React.useState<readonly AndroidHostTab[]>([]);
+  const [draft, setDraft] = React.useState('');
+  const presentedUrl = React.useRef('');
+  const directoryKey = normalizeContextPanelDirectoryKey(directory);
+  const needsAddress = !initialUrl.trim();
+
+  React.useEffect(() => subscribeAndroidHost(directoryKey, () => {
+    const host = readAndroidBrowserHost();
+    setHostMissing(host === null);
+    setTabs(host ? readAndroidHostTabs(host.tabs()) : []);
+  }), [directoryKey]);
+  React.useEffect(() => {
+    const onState = (event: Event) => {
+      const next = readAndroidHostStateEvent(event);
+      if (next.length > 0) setTabs(next);
+    };
+    window.addEventListener('andchamber-browser-host-state', onState);
+    return () => window.removeEventListener('andchamber-browser-host-state', onState);
+  }, []);
+
+  React.useEffect(() => {
+    if (!visible || hostMissing || needsAddress) return;
+    selectAndroidHostTab(tabID, true, directoryKey);
+  }, [directoryKey, hostMissing, needsAddress, tabID, visible]);
+
+  const submitAddress = (value: string) => {
+    const url = normalizeBrowserUrl(value);
+    if (!url.startsWith('http://') && !url.startsWith('https://')) return;
+    if (presentedUrl.current === url) return;
+    if (!presentAndroidBrowserTab(url, ownerSessionId)) return;
+    presentedUrl.current = url;
+  };
+
+  if (hostMissing) {
+    return (
+      <div className="flex h-full min-h-0 flex-col items-center justify-center gap-2 bg-background p-6 text-center" data-testid="android-browser-host-missing">
+        <span className="typography-ui-header text-foreground">Android browser host is not available</span>
+        <span className="typography-micro text-muted-foreground">This server is in Android browser mode. The page is not opened in an iframe or the desktop browser.</span>
+      </div>
+    );
+  }
+
+  const current = tabs.find((tab) => tab.tabId === tabID);
+  return (
+    <div className="flex h-full min-h-0 flex-col bg-background" data-testid="android-browser-host">
+      {needsAddress ? (
+        <form
+          className="flex items-center gap-2 border-b border-border p-2"
+          data-testid="android-browser-address"
+          onSubmit={(event) => {
+            event.preventDefault();
+            const field = event.currentTarget.elements.namedItem('address');
+            const entered = field && 'value' in field && typeof field.value === 'string' ? field.value : draft;
+            submitAddress(entered);
+          }}
+        >
+          <input
+            name="address"
+            value={draft}
+            onChange={(event) => setDraft(event.target.value)}
+            spellCheck={false}
+            autoComplete="off"
+            placeholder="https://"
+            aria-label="Browser address"
+            className="oc-raised oc-field h-6 min-w-0 flex-1 rounded-full bg-[var(--surface-elevated)] px-3 typography-micro text-foreground outline-none"
+          />
+          <Button type="submit" size="xs" variant="secondary">Open</Button>
+        </form>
+      ) : null}
+      <div className="flex min-h-0 flex-1 items-center justify-center p-6 text-center">
+        <span className="typography-micro text-muted-foreground">
+          {current?.url || initialUrl || 'Enter an address to open the page in the Android browser.'}
+        </span>
+      </div>
+    </div>
+  );
+};
