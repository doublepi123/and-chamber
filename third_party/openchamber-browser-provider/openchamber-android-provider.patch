+import { afterEach, describe, expect, test } from 'bun:test';
+import React from 'react';
+import { createRoot } from 'react-dom/client';
+
+import { useSessionUIStore } from '@/sync/session-ui-store';
+
+import { resetAndroidHostContextSync, useAndroidHostContextSync } from './useAndroidHostContextSync';
+
+const Probe = () => {
+  useAndroidHostContextSync();
+  return null;
+};
+
+const installDom = async () => {
+  const { Window } = await import('happy-dom');
+  const dom = new Window();
+  Object.assign(globalThis, { window: dom, document: dom.document });
+};
+
+describe('android host context sync', () => {
+  afterEach(() => {
+    document.body.innerHTML = '';
+    Reflect.deleteProperty(window, '__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__');
+    Reflect.deleteProperty(window, 'AndChamberBrowserHost');
+    useSessionUIStore.setState({ currentSessionId: null, currentSessionDirectory: null });
+    resetAndroidHostContextSync();
+  });
+
+  test('sends context when the session changes without a browser pane', async () => {
+    await installDom();
+    const contexts: unknown[] = [];
+    window.__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__ = true;
+    window.AndChamberBrowserHost = {
+      present: () => undefined,
+      select: () => undefined,
+      close: () => undefined,
+      tabs: () => [],
+      context: (context) => contexts.push(context),
+    };
+    useSessionUIStore.setState({ currentSessionId: 'ses_1', currentSessionDirectory: '/repo' });
+    const host = document.createElement('div');
+    document.body.append(host);
+    const root = createRoot(host);
+    root.render(React.createElement(Probe));
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    useSessionUIStore.setState({ currentSessionId: 'ses_2', currentSessionDirectory: '/repo' });
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(contexts.some((context) => JSON.stringify(context) === JSON.stringify({ sessionId: 'ses_2', directory: '/repo' }))).toBe(true);
+
+    useSessionUIStore.setState({ currentSessionId: null, currentSessionDirectory: null });
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(contexts.some((context) => JSON.stringify(context) === JSON.stringify({ sessionId: '', directory: null }))).toBe(true);
+    root.unmount();
+  });
+
+  test('does nothing outside Android mode', async () => {
+    await installDom();
+    const contexts: unknown[] = [];
+    window.AndChamberBrowserHost = {
+      present: () => undefined,
+      select: () => undefined,
+      close: () => undefined,
+      tabs: () => [],
+      context: (context) => contexts.push(context),
+    };
+    useSessionUIStore.setState({ currentSessionId: 'ses_1', currentSessionDirectory: '/repo' });
+    const host = document.createElement('div');
+    document.body.append(host);
+    const root = createRoot(host);
+    root.render(React.createElement(Probe));
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    useSessionUIStore.setState({ currentSessionId: null });
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(contexts).toEqual([]);
+    root.unmount();
+  });
+});
