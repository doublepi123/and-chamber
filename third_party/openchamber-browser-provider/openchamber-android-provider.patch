+import { afterEach, describe, expect, test } from 'bun:test';
+import React from 'react';
+import { createRoot } from 'react-dom/client';
+
+import { I18nProvider } from '@/lib/i18n';
+import { MobileBrowserPane, MobileWorkspaceDrawer } from './MobileWorkspaceDrawer';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+
+const render = (node: React.ReactElement) => {
+  const host = document.createElement('div');
+  document.body.append(host);
+  const root = createRoot(host);
+  root.render(React.createElement(I18nProvider, null, node));
+  return root;
+};
+
+const installDom = async () => {
+  const { Window } = await import('happy-dom');
+  const dom = new Window();
+  Object.assign(globalThis, {
+    window: dom,
+    document: dom.document,
+    HTMLElement: dom.HTMLElement,
+    HTMLInputElement: dom.HTMLInputElement,
+    Element: dom.Element,
+    Node: dom.Node,
+    ResizeObserver: class {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    },
+  });
+};
+
+describe('mobile browser entry', () => {
+  afterEach(() => {
+    document.body.innerHTML = '';
+    Reflect.deleteProperty(window, '__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__');
+    Reflect.deleteProperty(window, 'AndChamberBrowserHost');
+    useSessionUIStore.setState({ currentSessionId: null });
+  });
+
+  test('the workspace tab is absent outside Android mode', async () => {
+    await installDom();
+    const root = render(React.createElement(MobileWorkspaceDrawer, {
+      open: true,
+      onClose: () => undefined,
+      tab: 'notes',
+      onTabChange: () => undefined,
+      pendingChangesDiff: null,
+      onOpenPlan: () => undefined,
+      onOpenMcpSettings: () => undefined,
+      variant: 'panel',
+    }));
+    await new Promise((resolve) => setTimeout(resolve, 40));
+    expect(document.querySelector('[data-testid="mobile-workspace-tab-browser"]')).toBeNull();
+    expect(document.querySelector('iframe')).toBeNull();
+    root.unmount();
+  });
+
+  test('presents once for the current session and creates no iframe', async () => {
+    await installDom();
+    const presented: unknown[] = [];
+    const contexts: unknown[] = [];
+    window.__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__ = true;
+    window.AndChamberBrowserHost = {
+      present: (request) => presented.push(request),
+      select: () => undefined,
+      close: () => undefined,
+      tabs: () => [],
+      context: (context) => contexts.push(context),
+    };
+    useSessionUIStore.setState({ currentSessionId: 'ses_1' });
+    let closed = false;
+    const root = render(React.createElement(MobileBrowserPane, { onPresented: () => { closed = true; } }));
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    const input = document.querySelector<HTMLInputElement>('[data-testid="android-browser-address"]');
+    const button = document.querySelector<HTMLButtonElement>('[data-testid="android-browser-open"]');
+    expect(input).not.toBeNull();
+    if (input) input.value = 'https://example.test/';
+    button?.click();
+    button?.click();
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(presented).toEqual([{ url: 'https://example.test/', ownerSessionId: 'ses_1' }]);
+    expect(closed).toBe(true);
+    expect(document.querySelector('iframe')).toBeNull();
+    root.unmount();
+  });
+
+  test('does not present without a chat session', async () => {
+    await installDom();
+    const presented: unknown[] = [];
+    window.__OPENCHAMBER_ANDROID_BROWSER_PROVIDER__ = true;
+    window.AndChamberBrowserHost = {
+      present: (request) => presented.push(request),
+      select: () => undefined,
+      close: () => undefined,
+      tabs: () => [],
+    };
+    const root = render(React.createElement(MobileBrowserPane, { onPresented: () => undefined }));
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(document.body.textContent).toContain('Start a chat');
+    expect(document.querySelector('[data-testid="android-browser-open"]')).toBeNull();
+    expect(presented).toEqual([]);
+    expect(document.querySelector('iframe')).toBeNull();
+    root.unmount();
+  });
+});
