+/**
+ * Child environments must not inherit the Android provider token.
+ *
+ * The token is deleted from process.env at startup. This filter is the second
+ * line: every spawn site that copies process.env passes the object through
+ * here, so a token restored into the parent env still cannot reach a child.
+ */
+
+import { omitProviderTokenFromEnv } from './android-provider.js';
+
+export const childProcessEnv = (source = process.env) => omitProviderTokenFromEnv(source);
