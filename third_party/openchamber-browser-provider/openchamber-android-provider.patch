+import React from 'react';
+import { createRoot } from 'react-dom/client';
+
+import { AndroidHostBrowser } from './AndroidHostBrowser';
+
+describe('AndroidHostBrowser', () => {
+  afterEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  test('does not create an iframe when the native host is missing', async () => {
+    const { Window } = await import('happy-dom');
+    const dom = new Window();
+    Object.assign(globalThis, {
+      window: dom,
+      document: dom.document,
+      HTMLElement: dom.HTMLElement,
+      HTMLInputElement: dom.HTMLInputElement,
+      Element: dom.Element,
+      Node: dom.Node,
+    });
+    const container = document.createElement('div');
+    document.body.appendChild(container);
+    const root = createRoot(container);
+    root.render(React.createElement(AndroidHostBrowser, {
+      initialUrl: 'https://example.test/',
+      directory: '/repo',
+      tabID: 'tab-1',
+      ownerSessionId: 'ses_1',
+      visible: true,
+    }));
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(container.querySelector('iframe')).toBeNull();
+    expect(document.querySelector('iframe')).toBeNull();
+    expect(container.querySelector('webview')).toBeNull();
+    expect(container.querySelector('[data-testid="android-browser-host-missing"]')).not.toBeNull();
+    root.unmount();
+  });
+
+  test('an empty URL tab does not call present, and a submitted URL calls it once', async () => {
+    const { Window } = await import('happy-dom');
+    const dom = new Window();
+    const presented: unknown[] = [];
+    Object.assign(globalThis, {
+      window: dom,
+      document: dom.document,
+      HTMLElement: dom.HTMLElement,
+      HTMLInputElement: dom.HTMLInputElement,
+      Element: dom.Element,
+      Node: dom.Node,
+      Event: dom.Event,
+    });
+    Object.assign(dom, {
+      AndChamberBrowserHost: {
+        present: (request: unknown) => presented.push(request),
+        select: () => undefined,
+        close: () => undefined,
+        tabs: () => [],
+      },
+    });
+    const container = document.createElement('div');
+    document.body.appendChild(container);
+    const root = createRoot(container);
+    root.render(React.createElement(AndroidHostBrowser, {
+      initialUrl: '',
+      directory: '/repo',
+      tabID: 'tab-new',
+      ownerSessionId: 'ses_1',
+      visible: true,
+    }));
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(presented).toEqual([]);
+    expect(document.querySelector('iframe')).toBeNull();
+    const input = container.querySelector('input');
+    expect(input).not.toBeNull();
+    if (!input) return;
+    input.value = 'example.test';
+    input.form?.requestSubmit();
+    input.form?.requestSubmit();
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(presented).toEqual([{ url: 'https://example.test/', ownerSessionId: 'ses_1' }]);
+    expect(document.querySelector('iframe')).toBeNull();
+    root.unmount();
+  });
+});
